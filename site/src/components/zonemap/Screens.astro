            <div class="pbtext" data-zone="composer-state" data-badge="tl">
              <span class="draftline">
                <span>Summarize</span>
                <span class="pill"><svg class="ic xs"><use href="#i-plug"/></svg>@release-notes</span>
                <span>and fix the</span>
                <span class="hl" data-zone="composer-rich-text" data-badge="br">TODO</span>
                <span>in checkout.</span>
              </span>
            </div>
            <div class="arow">
              <div class="agroup">
                <span class="abtn slot"><svg class="ic"><use href="#i-plus"/></svg></span>
                <span class="modelchip"><svg class="ic s"><use href="#i-code"/></svg>Fable 5 <span class="lv">High</span><svg class="ic xs"><use href="#i-chevdown"/></svg></span>
              </div>
              <span class="spacer"></span>
              <div class="agroup">
                <span class="abtn slot" data-zone="composer-actions" data-badge="tl"><svg class="ic s"><use href="#i-plug"/></svg></span>
                <span class="abtn"><svg class="ic"><use href="#i-mic"/></svg></span>
                <span class="abtn send"><svg class="ic s"><use href="#i-send"/></svg></span>
              </div>
            </div>
          </div>
          <div class="cfoot">
            <span class="l">
              <span class="chipm"><svg class="ic s"><use href="#i-folder"/></svg>bb-plugin-hello</span>
              <span class="chipm subtle"><svg class="ic s"><use href="#i-branch"/></svg>worktree</span>
            </span>
            <span class="subtle">Full Access</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

