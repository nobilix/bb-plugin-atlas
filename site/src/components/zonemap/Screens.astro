---
/*
 * The bb window, seven screens of it, as static markup.
 *
 * Static markup, because the structure is the fixture: the island finds every
 * zone by the `data-zone`, `data-badge` and `data-fx` attributes on these
 * elements and measures the real boxes. As JSX it would ship every one of
 * these lines as JavaScript. Rendered here it is HTML, it costs nothing to
 * hydrate, and it is there before the island is.
 *
 * **The text is bb's, not ours.** `New thread`, `Search threads`, `Plugins`,
 * `Skills`, `Quick palette`, `Report a bug` and the rest are what a user sees
 * on screen, and TRANSLATION-GUIDE is explicit that bb's own UI strings are
 * never translated. The strings that are the atlas's own — a pan hint and the
 * legend heading — belong to the chrome around the mockup, which the island
 * renders in the page's locale.
 * The backend screen's cards are the exception: their titles, taglines and
 * section headings are the atlas's surface records, not bb's UI, so they
 * arrive already translated on `/ru/map/`.
 *
 * The icon sprite comes with it: every `<use href="#i-…">` below resolves here.
 *
 * The seventh screen — the backend, which has no interface of its own — is a
 * list of names and taglines that never changes, so it is rendered here rather
 * than by script. That is what lets the island stay clear of `react-dom`'s
 * portal API: 11 KB of JavaScript to place static text.
 */
import type { ZoneGroup } from '../ZoneMap.tsx';
import { plainText } from '../../lib/inline-md';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  groups: ZoneGroup[];
  locale?: Locale;
}

const { groups, locale = 'en' } = Astro.props;
const headless = groups.find((group) => group.id === 'headless');
const surfaceById = new Map(
  groups.flatMap((group) => group.surfaces.map((surface) => [surface.id, surface] as const)),
);
---

