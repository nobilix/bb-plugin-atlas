---
/*
 * Version stamp for generated pages:
 * bb 0.43.3 · SDK 0.4.104 · pinned commit. Values come from `pin.json`;
 * nothing here is typed by hand.
 */
import { commitUrl, pin, shortCommit } from '../lib/pin';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
  class?: string;
}
const { locale = 'en', class: className } = Astro.props;
---

<p class:list={['atlas-stamp', className]} data-atlas-version-stamp data-pagefind-ignore>
  <span>bb <code>{pin.upstream.bbVersion}</code></span>
  <span aria-hidden="true">·</span>
  <span>SDK <code>{pin.upstream.sdkVersion}</code></span>
  <span aria-hidden="true">·</span>
  <span>
    {t(locale, 'stamp.pinned')} <a href={commitUrl} rel="noreferrer"><code>{shortCommit}</code></a>{' '}
    <span class="atlas-stamp__tag">({pin.upstream.tag})</span>
  </span>
</p>

<style>
  .atlas-stamp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 21px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--color-silver);
    font-size: var(--sl-text-xs);
    line-height: 20px;
    color: var(--color-smoke);
  }

  .atlas-stamp code {
    font-family: var(--font-mono-system);
    font-size: var(--sl-text-xs);
    color: var(--color-graphite);
    background: none;
    border: 0;
    padding: 0;
  }

  .atlas-stamp a {
    color: inherit;
    text-decoration-color: var(--color-silver);
  }

  .atlas-stamp a:hover {
    color: var(--color-cobalt-signal);
  }

  .atlas-stamp__tag {
    color: var(--color-ash);
  }
</style>
