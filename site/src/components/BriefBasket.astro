---
/*
 * The set panel: what a reader has collected, and the one Markdown brief that
 * builds all of it as a single plugin.
 *
 * A custom element, for the same reason `BriefActions` is one — and the two are
 * always on a page together, so a React runtime here would defeat the point of
 * avoiding one there.
 *
 * It stays out of sight until the set has something in it, so a reader who
 * never uses the feature never sees it. With something in it, it starts as a
 * small pill in the corner and opens on demand: an open panel is fixed over the
 * page, and while it is visible the page reserves room at its foot so the last
 * controls, "Add to set" among them, can always be scrolled clear of it.
 * "Clear" asks for a second click, because it is the one control that loses
 * work.
 *
 * The corpus is fetched, not bundled: `/briefs.json` already serves every brief
 * and the rule bank at a stable URL, and the set can name a capability from any
 * page, not just this one. The fetch happens on the first copy, so a page that
 * is only read never makes it.
 *
 * The renderer is loaded the same way, and for a sharper reason. `renderBasket`
 * is a few hundred bytes of string building, but it lives in the module that
 * also holds `createBriefs`, which reaches the curated annotation bank — and
 * that bank does not tree-shake away, because a top-level `Object.freeze` reads
 * to Rollup as a side effect worth keeping. Imported statically it put 170 KB
 * on all 96 generated pages, nearly ten times what such a page ships.
 * `await import(...)` moves it into a chunk nothing fetches until someone
 * actually asks for the set as Markdown. The alternative, a second copy of the
 * templates small enough to inline, would be a second generator to keep in step.
 *
 * The panel speaks the page's locale; the set's contents do not. An entry's
 * title is the brief's, English on every page, because the set is one
 * `localStorage` key shared by every locale and what it copies is an English
 * brief. The strings the script writes arrive as `data-msg-*` templates.
 */
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
---

<atlas-brief-basket
  class="atlas-basket"
  hidden
  data-msg-count={t(locale, 'basket.count')}
  data-msg-open={t(locale, 'basket.open')}
  data-msg-remove={t(locale, 'basket.remove')}
  data-msg-copied={t(locale, 'brief.copied')}
  data-msg-copy-failed={t(locale, 'brief.copyFailed')}
  data-msg-clear-confirm={t(locale, 'basket.clearConfirm')}
  data-pagefind-ignore
>
  <button
    type="button"
    class="atlas-basket__pill"
    data-act="expand"
    aria-expanded="false"
    aria-controls="atlas-basket-panel"
  >
    <span data-pill></span>
  </button>
  <div class="atlas-basket__panel" id="atlas-basket-panel" hidden>
    <div class="atlas-basket__head">
      <p class="atlas-basket__count" data-count aria-live="polite"></p>
      <button
        type="button"
        class="atlas-basket__collapse"
        data-act="collapse"
        aria-label={t(locale, 'basket.collapse')}
        title={t(locale, 'basket.collapse')}
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
    <ul class="atlas-basket__list" data-list></ul>
    <div class="atlas-basket__bar">
      <button type="button" class="atlas-basket__button" data-act="copy">
        <span data-label>{t(locale, 'basket.copy')}</span>
      </button>
      <button type="button" class="atlas-basket__button atlas-basket__button--ghost" data-act="clear">
        <span data-label>{t(locale, 'basket.clear')}</span>
      </button>
    </div>
  </div>
</atlas-brief-basket>

<script>
  import {
    BASKET_EVENT,
    clearBasket,
    readBasket,
    removeFromBasket,
    type BasketEntry,
  } from './basket.ts';
  import { copyText, flash } from './clipboard.ts';
  import type { Brief, BriefPin, RuleBank } from '@atlas/core/briefs';

  interface Corpus {
    generatedFor: BriefPin;
    rules: RuleBank;
    briefs: Brief[];
  }

  let corpus: Promise<Corpus> | null = null;
  function loadCorpus(): Promise<Corpus> {
    const url = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/briefs.json`;
    corpus ??= fetch(url).then((response) => {
      if (!response.ok) throw new Error(`${url}: ${response.status}`);
      return response.json() as Promise<Corpus>;
    });
    return corpus;
  }

  const CLEAR_CONFIRM_MS = 3000;

  class AtlasBriefBasket extends HTMLElement {
    private wired = false;
    /* -1 until the first render, so a page that loads with a full set does not bump. */
    private count = -1;
    private clearArmedUntil = 0;

    connectedCallback() {
      /* Out of the article and onto the body. A fixed panel left inside
       * Starlight's content column is painted under the right-hand sidebar,
       * which is a full-width fixed box over that half of the window: the panel
       * was there, positioned correctly, and invisible. Moving the element
       * re-enters this callback, hence the guard. */
      if (this.parentElement !== document.body) {
        document.body.append(this);
        return;
      }
      if (this.wired) return;
      this.wired = true;

      const render = () => this.render(readBasket());
      window.addEventListener(BASKET_EVENT, render);
      /* Another tab may have changed the set; `atlas.basket` is one key and one
       * meaning wherever it is written. */
      window.addEventListener('storage', render);
      this.addEventListener('click', (event) => this.onClick(event));
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.isOpen) this.setOpen(false);
      });
      /* The page keeps room at its foot for whatever the panel covers. */
      new ResizeObserver(() => this.reserveSpace()).observe(this);
      render();
    }

    private get panel() {
      return this.querySelector<HTMLElement>('.atlas-basket__panel');
    }

    private get pill() {
      return this.querySelector<HTMLButtonElement>('.atlas-basket__pill');
    }

    private get isOpen() {
      return this.panel?.hidden === false;
    }

    private setOpen(open: boolean) {
      const { panel, pill } = this;
      if (!panel || !pill) return;
      panel.hidden = !open;
      pill.hidden = open;
      pill.setAttribute('aria-expanded', String(open));
      (open ? this.querySelector<HTMLElement>('[data-act="collapse"]') : pill)?.focus();
    }

    private reserveSpace() {
      const height = this.hidden ? 0 : this.getBoundingClientRect().height;
      const root = document.documentElement.style;
      if (height > 0) root.setProperty('--atlas-basket-reserve', `${Math.ceil(height) + 34}px`);
      else root.removeProperty('--atlas-basket-reserve');
    }

    render(items: BasketEntry[]) {
      const grew = this.count >= 0 && items.length > this.count;
      this.count = items.length;
      this.hidden = items.length === 0;
      if (this.hidden && this.isOpen) this.setOpen(false);

      const fill = (template: string | undefined) =>
        (template ?? '').replace('{count}', String(items.length));
      const pillText = this.querySelector('[data-pill]');
      if (pillText) pillText.textContent = fill(this.dataset.msgOpen);
      const count = this.querySelector('[data-count]');
      if (count) count.textContent = fill(this.dataset.msgCount);
      /* A collapsed set still says it changed. */
      if (grew && this.pill) {
        this.pill.classList.remove('is-bumped');
        void this.pill.offsetWidth;
        this.pill.classList.add('is-bumped');
      }

      this.querySelector('[data-list]')?.replaceChildren(
        ...items.map((item) => {
          const row = document.createElement('li');
          const name = document.createElement('span');
          name.textContent = item.title;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'atlas-basket__remove';
          remove.dataset.act = 'remove';
          remove.dataset.kind = item.kind;
          remove.dataset.id = item.id;
          remove.setAttribute(
            'aria-label',
            (this.dataset.msgRemove ?? '').replace('{title}', item.title),
          );
          remove.textContent = '×';
          row.append(name, remove);
          return row;
        }),
      );
      this.reserveSpace();
    }

    async onClick(event: Event) {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
      if (!button) return;
      const label = button.querySelector('[data-label]');

      switch (button.dataset.act) {
        case 'expand':
          this.setOpen(true);
          return;
        case 'collapse':
          this.setOpen(false);
          return;
        case 'remove':
          removeFromBasket(button.dataset.kind ?? '', button.dataset.id ?? '');
          return;
        case 'clear':
          if (Date.now() < this.clearArmedUntil) {
            this.clearArmedUntil = 0;
            clearBasket();
          } else if (label) {
            this.clearArmedUntil = Date.now() + CLEAR_CONFIRM_MS;
            flash(label, this.dataset.msgClearConfirm ?? '', CLEAR_CONFIRM_MS);
          }
          return;
      }
      if (button.dataset.act !== 'copy' || !label) return;

      const items = readBasket();
      if (items.length === 0) return;
      try {
        const [data, { renderBasket }] = await Promise.all([
          loadCorpus(),
          import('@atlas/core/briefs'),
        ]);
        const index = new Map(data.briefs.map((brief) => [`${brief.kind}:${brief.id}`, brief]));
        const chosen = items
          .map((item) => index.get(`${item.kind}:${item.id}`))
          .filter((brief): brief is Brief => brief !== undefined);
        if (chosen.length === 0) throw new Error('nothing in the corpus matched the set');
        flash(
          label,
          ((await copyText(renderBasket(chosen, data.generatedFor, data.rules)))
            ? this.dataset.msgCopied
            : this.dataset.msgCopyFailed) ?? '',
        );
      } catch {
        flash(label, this.dataset.msgCopyFailed ?? '');
      }
    }
  }

  if (!customElements.get('atlas-brief-basket')) {
    customElements.define('atlas-brief-basket', AtlasBriefBasket);
  }
</script>

<style>
  /* Room at the foot of the page for the panel, so nothing ends up under it. */
  :global(body) {
    padding-bottom: var(--atlas-basket-reserve, 0px);
  }

  .atlas-basket {
    bottom: 17px;
    display: block;
    inset-inline-end: 17px;
    max-width: min(320px, calc(100vw - 34px));
    position: fixed;
    z-index: 30;
  }

  .atlas-basket[hidden],
  .atlas-basket [hidden] {
    display: none;
  }

  .atlas-basket__pill {
    background: var(--color-charcoal);
    border: 1px solid var(--color-charcoal);
    border-radius: 9999px;
    color: var(--color-snow);
    cursor: pointer;
    display: block;
    font: 600 var(--sl-text-xs) / 20px var(--font-sen);
    margin-inline-start: auto;
    padding: 5px 15px;
  }

  .atlas-basket__pill.is-bumped {
    animation: atlas-basket-bump 400ms ease-out;
  }

  @keyframes atlas-basket-bump {
    40% {
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-basket__pill.is-bumped {
      animation: none;
    }
  }

  .atlas-basket__panel {
    background: var(--color-snow);
    border: 1px solid var(--color-silver);
    border-radius: 12px;
    padding: 13px 17px;
  }

  .atlas-basket__head {
    align-items: center;
    display: flex;
    gap: 8px;
    justify-content: space-between;
  }

  .atlas-basket__count {
    color: var(--color-charcoal);
    font: 600 var(--sl-text-sm) / 20px var(--font-sen);
    margin: 0;
  }

  .atlas-basket__collapse {
    background: none;
    border: 0;
    border-radius: 6px;
    color: var(--color-graphite);
    cursor: pointer;
    display: grid;
    padding: 2px;
    place-items: center;
  }

  .atlas-basket__collapse:hover {
    background: var(--color-fog);
    color: var(--color-charcoal);
  }

  .atlas-basket__bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 13px;
  }

  .atlas-basket__button {
    background: var(--color-charcoal);
    border: 1px solid var(--color-charcoal);
    border-radius: 9999px;
    color: var(--color-snow);
    cursor: pointer;
    font: 600 var(--sl-text-xs) / 20px var(--font-sen);
    padding: 3px 13px;
  }

  .atlas-basket__button--ghost {
    background: transparent;
    border-color: var(--color-graphite);
    color: var(--color-charcoal);
    font-weight: 500;
  }

  .atlas-basket__list {
    list-style: none;
    margin: 8px 0 0;
    max-height: 30vh;
    overflow-y: auto;
    padding: 0;
  }

  /* The rows and their remove buttons are created by the script, so they carry
   * no scoping attribute: these rules reach them through `:global`. */
  .atlas-basket__list :global(li) {
    align-items: baseline;
    color: var(--color-graphite);
    display: flex;
    font: 400 var(--sl-text-xs) / 20px var(--font-sen);
    gap: 8px;
    justify-content: space-between;
  }

  .atlas-basket__list :global(.atlas-basket__remove) {
    background: none;
    border: 0;
    color: var(--color-smoke);
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    padding: 0 2px;
  }

  .atlas-basket__list :global(.atlas-basket__remove:hover) {
    color: var(--color-charcoal);
  }
</style>
