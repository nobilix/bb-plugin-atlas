---
/*
 * Starlight component override: the page header gains the
 * "Copy page as Markdown" control beside the title.
 *
 * Wraps Starlight's own PageTitle rather than reimplementing its <h1>, so a
 * Starlight minor that changes the heading markup does not silently change ours.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import CopyPageMarkdown from '../CopyPageMarkdown.astro';
import { toLocale } from '../../i18n/ui';
import { localePath } from '../../i18n/routes';

/*
 * `/map/` (and a localised `/<lang>/map/`) spends its height on the map. Its
 * toolbar already says what the page is, so the heading is there for screen
 * readers and search engines only, and this is the one place the <h1> is
 * written here rather than by Starlight.
 *
 * Nor does it get the copy control: its `.md` twin is one sentence saying it is
 * an interactive mockup, which is not what the button promises.
 */
const locale = toLocale(Astro.locals.starlightRoute.lang);
const isMap = Astro.url.pathname.replace(/\/*$/, '/') === localePath(locale, '/map/');
---

{
  isMap ? (
    <div class="atlas-page-head atlas-page-head--hidden">
      <h1 id="_top" class="sr-only">
        {Astro.locals.starlightRoute.entry.data.title}
      </h1>
    </div>
  ) : (
    <div class="atlas-page-head">
      <Default>
        <slot />
      </Default>
      <CopyPageMarkdown locale={locale} />
    </div>
  )
}

<style>
  .atlas-page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 13px;
  }

  .atlas-page-head > :global(h1) {
    margin: 0;
  }
</style>
