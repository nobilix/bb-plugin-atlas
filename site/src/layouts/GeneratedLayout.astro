---
/*
 * Chrome for every generated page: Starlight's own page shell, the version
 * stamp, and the link to the raw Markdown twin.
 *
 * No island here: an island in a shared layout costs every page its runtime.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { MarkdownHeading } from 'astro';
import VersionStamp from '../components/VersionStamp.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  headings?: MarkdownHeading[];
}

const { title, description, locale, headings = [] } = Astro.props;
---

<StarlightPage frontmatter={{ title, description }} headings={headings}>
  <VersionStamp locale={locale} />
  <slot />
</StarlightPage>
