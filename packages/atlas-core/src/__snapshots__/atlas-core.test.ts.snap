- \`PluginSidebarThreadRowStatus\` — packages/plugin-sdk/src/app-contract.ts:1807
- \`useSidebarSplitLayout\` — packages/plugin-sdk/src/app.ts:337
- \`PluginSidebarSplitLayout\` — packages/plugin-sdk/src/app-contract.ts:2589
- \`useSidebarThreadShortcut\` — packages/plugin-sdk/src/app.ts:338
- \`PluginSidebarThreadShortcut\` — packages/plugin-sdk/src/app-contract.ts:1813
- \`ThreadTitle\` — packages/plugin-sdk/src/app.ts:341
- \`PluginThreadTitleProps\` — packages/plugin-sdk/src/app-contract.ts:1676
- \`experimental_ThreadStatusGlyph\` — packages/plugin-sdk/src/app.ts:342
- \`PluginThreadStatusGlyphProps\` — packages/plugin-sdk/src/app-contract.ts:1749
- \`experimental_resolveThreadStatus\` — packages/plugin-sdk/src/internal/thread-status.ts:121
